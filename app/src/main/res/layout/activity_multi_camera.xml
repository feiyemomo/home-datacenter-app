<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/bg_primary">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/card_bg"
        app:navigationIcon="@drawable/ic_baseline_arrow_back_24"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/multi_camera_title"
        app:subtitle="@string/multi_camera_subtitle"
        app:titleTextColor="@color/text_primary"
        app:subtitleTextColor="@color/text_secondary">

        <!-- v1.13.0: Grid mode switcher (1-grid / 4-grid / 9-grid) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGridMode"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="4格"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            app:cornerRadius="18dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1.5dp"
            app:backgroundTint="@color/card_bg"
            app:icon="@drawable/ic_grid_view"
            app:iconTint="@color/text_primary"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:iconPadding="4dp" />

        <!-- Aspect ratio toggle (fitCenter vs centerCrop) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAspectRatio"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="适应"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            app:cornerRadius="18dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1.5dp"
            app:backgroundTint="@color/card_bg"
            app:icon="@drawable/ic_aspect_ratio"
            app:iconTint="@color/text_primary"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:iconPadding="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleLandscape"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="横屏全屏"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            app:cornerRadius="18dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1.5dp"
            app:backgroundTint="@color/card_bg"
            app:icon="@drawable/ic_fullscreen"
            app:iconTint="@color/text_primary"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:iconPadding="4dp" />
    </com.google.android.material.appbar.MaterialToolbar>

