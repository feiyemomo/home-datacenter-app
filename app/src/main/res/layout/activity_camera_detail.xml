<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Compose TopBar: Pure Liquid Glass navigation bar with online dot & IP -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Video player: rendered edge-to-edge below the toolbar -->
        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent">

            <!-- Digital Pinch-to-Zoom container -->
            <com.homedatacenter.app.ui.cameras.PinchToZoomFrameLayout
                android:id="@+id/pinchZoomContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/zoomContentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.exoplayer2.ui.StyledPlayerView
                        android:id="@+id/playerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        app:surface_type="texture_view"
                        app:resize_mode="fit"
                        app:use_controller="true"
                        app:show_buffering="when_playing"
                        app:show_timeout="3000" />

                    <!-- WebRTC surface -->
                    <com.homedatacenter.app.ui.cameras.SafeSurfaceViewRenderer
                        android:id="@+id/surfaceRenderer"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                    <!-- JPEG preview frame -->
                    <ImageView
                        android:id="@+id/ivPreviewFrame"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:background="@android:color/black"
                        android:visibility="gone" />
                </FrameLayout>
            </com.homedatacenter.app.ui.cameras.PinchToZoomFrameLayout>

            <!-- Zoom factor indicator badge -->
            <TextView
                android:id="@+id/tvZoomBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_margin="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="#99000000"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <!-- Stream strategy badge -->
            <TextView
                android:id="@+id/tvStreamStrategy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="#80000000"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <!-- HLS latency notice -->
            <TextView
                android:id="@+id/tvHlsNotice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_hls_notice"
                android:text="连接路径不畅通"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <!-- WebRTC control overlay -->
            <LinearLayout
                android:id="@+id/webRtcControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:background="#80000000"
                android:padding="6dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWebRtcPause"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    app:icon="@drawable/ic_pause"
                    app:iconTint="@android:color/white"
                    app:iconSize="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWebRtcMute"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    app:icon="@drawable/ic_volume_on"
                    app:iconTint="@android:color/white"
                    app:iconSize="24dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Quality toggle button (720P / 1080P) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWebRtcQuality"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="6dp"
                    android:text="720P"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_glass_dark_panel"
                    app:strokeWidth="1dp"
                    app:strokeColor="#33FFFFFF" />

                <!-- PiP button in WebRTC control overlay -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWebRtcPip"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="2dp"
                    android:background="@android:color/transparent"
                    app:icon="@drawable/ic_pip"
                    app:iconTint="@android:color/white"
                    app:iconSize="24dp" />

                <!-- Fullscreen button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWebRtcFullscreen"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    app:icon="@drawable/ic_fullscreen"
                    app:iconTint="@android:color/white"
                    app:iconSize="24dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvVideoError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="16dp"
                android:text="@string/camera_video_failed"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_glass_card"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Pure Jetpack Compose Controls: Action Row, PTZ Compass, Presets, Settings -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
