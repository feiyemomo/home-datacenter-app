<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_card"
    android:padding="16dp"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp">

    <!-- Top line: Rule name + Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivRuleIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_bolt"
            app:tint="@color/accent"
            android:contentDescription="rule icon" />

        <TextView
            android:id="@+id/tvRuleName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="夜间人形入侵告警" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Trigger & Action Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTrigger"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="触发: 人形检测"
            android:textSize="11sp"
            app:chipCornerRadius="8dp"
            app:chipStrokeWidth="0dp"
            android:clickable="false"
            android:focusable="false" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAction"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:text="动作: 通知"
            android:textSize="11sp"
            app:chipCornerRadius="8dp"
            app:chipStrokeWidth="0dp"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>

    <!-- Condition details -->
    <TextView
        android:id="@+id/tvCondition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        tools:text="条件: 时间段 22:00 - 06:00 · 置信度 ≥ 80%" />

    <!-- Action target details -->
    <TextView
        android:id="@+id/tvActionDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="目标: 紧急通知 · 家人全员" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp" />

    <!-- Bottom actions: Fire stats + Test / Edit / Delete buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvFireStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            tools:text="已触发 12 次 · 冷却 60s" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTest"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="8dp"
            android:textSize="12sp"
            android:textColor="@color/accent"
            android:text="@string/automations_test" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEdit"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="8dp"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:text="@string/automations_edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="8dp"
            android:textSize="12sp"
            android:textColor="@color/error"
            android:text="@string/btn_delete" />
    </LinearLayout>

</LinearLayout>
