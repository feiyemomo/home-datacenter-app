<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass dialog surface: warmer and softer than bg_card_rounded.
     26dp corners (dialog hierarchy sits above 20/22dp cards), translucent
     frosted body over the dimmed backdrop, warm border, and a top-edge
     highlight line that simulates light refracting through glass.
     All colors resolve through @color/glass_* so dark mode switches
     automatically via values-night. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft drop shadow under the dialog -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_shadow" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- Frosted glass body -->
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_bg" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
    <!-- Top-edge refraction highlight -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="25dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/glass_highlight"
                android:endColor="@android:color/transparent" />
            <corners
                android:radius="25dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
