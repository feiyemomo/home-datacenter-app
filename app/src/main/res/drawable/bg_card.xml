<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle card surface for alerts/recordings/logs: Liquid glass surface with
     translucent substrate, specular border and soft highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_shadow" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Main card body -->
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_bg" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.2dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
    <!-- Subtle top highlight for depth -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="19dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/glass_highlight"
                android:endColor="@android:color/transparent" />
            <corners
                android:radius="19dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
