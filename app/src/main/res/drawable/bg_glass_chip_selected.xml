<?xml version="1.0" encoding="utf-8"?>
<!-- Glass filter chip (selected) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40818CF8">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#406366F1" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#80A5B4FC" />
                </shape>
            </item>
            <item
                android:left="1dp"
                android:right="1dp"
                android:top="1dp"
                android:bottom="18dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#40C7D2FE"
                        android:endColor="#00000000" />
                    <corners
                        android:topLeftRadius="13dp"
                        android:topRightRadius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
