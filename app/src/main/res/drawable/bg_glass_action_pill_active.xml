<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass action pill (active/accented state) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4010B981">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#3310B981" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#8010B981" />
                </shape>
            </item>
            <item
                android:left="1dp"
                android:right="1dp"
                android:top="1dp"
                android:bottom="24dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#4034D399"
                        android:endColor="#00000000" />
                    <corners
                        android:topLeftRadius="13dp"
                        android:topRightRadius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
