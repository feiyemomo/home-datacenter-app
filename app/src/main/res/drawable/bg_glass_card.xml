<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass card: pure card-bg surface + unified 1px card-border, 22dp radius -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft drop shadow under card -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_shadow" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Main card body -->
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="@color/card_border" />
        </shape>
    </item>
</layer-list>
