<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass card: base fill + subtle top-edge highlight + warm border.
     Matches web .glass class: top light line creates the "liquid edge" feel,
     warm translucent border, soft corner radius 22dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft drop shadow under card -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_shadow" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Main card body -->
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_bg" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
    <!-- Top-edge highlight: thin bright line at top simulates glass refraction -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="21dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="-90"
                android:startColor="@color/glass_highlight"
                android:endColor="@android:color/transparent" />
            <corners
                android:radius="21dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
