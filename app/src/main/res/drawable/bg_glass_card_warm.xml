<?xml version="1.0" encoding="utf-8"?>
<!-- Warm liquid glass card: same glass effect as bg_glass_card but 22dp corners,
     uses @color/glass_bg so it adapts to dark mode automatically.
     Top highlight creates the "liquid refraction" edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_shadow" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Main body -->
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Top-edge highlight -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="21dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/glass_highlight"
                android:endColor="@android:color/transparent" />
            <corners
                android:radius="21dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
