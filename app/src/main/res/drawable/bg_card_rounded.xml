<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard & system cards: Liquid glass surface with translucent ambient fill,
     specular glass border and top light refraction line (unifies with bg_glass_card). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_shadow" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Main card body: translucent glass body + specular border -->
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_bg" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1.2dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
    <!-- Top-edge highlight: glassy light refraction edge -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="21dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/glass_highlight"
                android:endColor="@android:color/transparent" />
            <corners
                android:radius="21dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
