<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard cards (weather, network quality): warm card background with
     glassy top highlight. 20dp corners for a friendly rounded feel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0C000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Main card body -->
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="@color/card_stroke" />
        </shape>
    </item>
    <!-- Top-edge highlight -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="19dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#12FFFFFF"
                android:endColor="@android:color/transparent" />
            <corners
                android:radius="19dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
