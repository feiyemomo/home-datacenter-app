<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass action pill for secondary actions adapting dynamically -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/btn_reload_ripple">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_subtle_fill" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/glass_border" />
                </shape>
            </item>
            <!-- Top highlight line -->
            <item
                android:left="1dp"
                android:right="1dp"
                android:top="1dp"
                android:bottom="24dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/glass_highlight"
                        android:endColor="@android:color/transparent" />
                    <corners
                        android:topLeftRadius="13dp"
                        android:topRightRadius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
