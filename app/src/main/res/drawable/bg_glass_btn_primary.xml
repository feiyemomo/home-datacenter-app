<?xml version="1.0" encoding="utf-8"?>
<!-- Radiant Primary Glass Button for Key CTAs (Add, Save, Submit) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/btn_primary_ripple">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="@color/btn_primary_start"
                        android:centerColor="@color/btn_primary_mid"
                        android:endColor="@color/btn_primary_end" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1.2dp"
                        android:color="@color/btn_primary_stroke" />
                </shape>
            </item>
            <item
                android:left="1dp"
                android:right="1dp"
                android:top="1dp"
                android:bottom="24dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/glass_highlight"
                        android:endColor="@android:color/transparent" />
                    <corners
                        android:topLeftRadius="13dp"
                        android:topRightRadius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
