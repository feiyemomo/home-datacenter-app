<?xml version="1.0" encoding="utf-8"?>
<!-- Minimalist crystalline dial surface for PTZ gimbal control -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle drop shadow -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/glass_shadow" />
        </shape>
    </item>

    <!-- Main dial surface: control_bg + 1px micro crystalline border -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/control_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/card_border" />
        </shape>
    </item>
</layer-list>
