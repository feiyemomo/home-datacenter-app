<?xml version="1.0" encoding="utf-8"?>
<!-- Floating capsule navigation bar background with liquid glass effect:
     soft shadow + translucent glass body + warm border + top-edge highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow/shadow under the bar -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_shadow" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Main glass body -->
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_bg" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
    <!-- Top-edge highlight for liquid glass feel -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="1dp"
        android:bottom="27dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/glass_highlight"
                android:endColor="@android:color/transparent" />
            <corners
                android:radius="26dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
