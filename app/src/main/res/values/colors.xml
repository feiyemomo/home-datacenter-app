<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary warm amber — matches web accent-warm: 215 160 100 -->
    <color name="primary">#D7A064</color>
    <color name="primary_dark">#C48D50</color>
    <color name="primary_light">#E8C49A</color>
    <!-- Secondary: warm peach-coral for highlights -->
    <color name="secondary">#E8A87C</color>
    <color name="secondary_dark">#D4956A</color>
    <!-- Accent: warm amber glow (used for stars, alert pulses) -->
    <color name="accent">#D4A055</color>

    <!-- Status colors — warm-toned variants -->
    <color name="online">#5CB880</color>
    <color name="offline">#9E9E9E</color>
    <color name="error">#E07070</color>
    <color name="warning">#D4A055</color>

    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>

    <!-- Text — warm dark slate (not cool blue-gray) -->
    <color name="text_primary">#3D3530</color>
    <color name="text_secondary">#8A7E72</color>
    <color name="text_hint">#B0A394</color>
    <color name="text_on_primary">#FFFFFF</color>

    <!-- Background — warm cream palette matching web bg: 246 241 234 (#F6F1EA) -->
    <color name="bg_primary">#F6F1EA</color>
    <color name="bg_secondary">#FDF8F2</color>
    <color name="bg_surface">#FFFCF8</color>
    <color name="divider">#E8DFD3</color>

    <!-- Glass effect — frosted warm white with top edge hint; matches web glass:
         backdrop white at 45-62% + warm tint -->
    <color name="glass_bg">#CCFFFFFF</color>
    <!-- v1.15.1: dialog surface. Dialogs float over a dimmed backdrop
         with hard-contrast content behind them, so the card-level
         80% white bled the screen underneath through and hurt
         legibility. 96% keeps the frosted hint while staying solid
         enough to read. -->
    <color name="glass_bg_dialog">#F5FFFCF8</color>
    <!-- Bottom nav body. Fully opaque: the bar floats over scrolling
         lists, and even a few percent of see-through made dense text
         (log rows, camera thumbnails) readable behind the tab labels.
         The liquid-glass look is carried by the border, the top-edge
         highlight and the drop shadow instead of by transparency. -->
    <color name="glass_bg_nav">#FFFFFFFF</color>
    <color name="glass_border">#33FFFFFF</color>
    <color name="glass_shadow">#14000000</color>
    <color name="glass_highlight">#26FFFFFF</color>

    <!-- Page gradient: warm cream → soft peach → warm ivory (no cold blue) -->
    <color name="gradient_start">#F8EDE0</color>
    <color name="gradient_mid">#FDF4EA</color>
    <color name="gradient_end">#F6F1EA</color>

    <!-- Card surfaces -->
    <color name="card_bg">#FFFCF8</color>
    <color name="card_stroke">#F0E4D4</color>
    <color name="camera_bg">#1A1A1A</color>
    <color name="card_bottom_bg">#FFFCF8</color>
    <color name="red">#E07070</color>

    <!-- Icon circle warm tint (28% alpha of primary amber) -->
    <color name="icon_circle_bg">#47D7A064</color>
    <color name="chip_warm_bg_checked">#33D7A064</color>
    <color name="chip_warm_text_checked">#B58049</color>

    <!-- v1.15.1: warm tonal container pair. Material 3's TonalButton /
         FilledTonalButton default to colorSecondaryContainer, which
         without an explicit override resolves to a lavender that
         clashes with the cream + amber identity. -->
    <color name="warm_container">#F3E0C7</color>
    <color name="on_warm_container">#7A5636</color>
</resources>
