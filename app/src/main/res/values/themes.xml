<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 theme with warm liquid glass palette.
         Uses DayNight so light/dark colors switch automatically. -->
    <style name="Theme.HomeDatacenter" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_secondary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <!-- v1.7.18: branded cold-start backdrop (warm gradient +
             centered logo) so the launcher window is never a flat
             color / white flash before SplashActivity renders. -->
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Soft glass dialog transitions (fade + subtle scale) -->
        <item name="android:windowAnimationStyle">@style/GlassDialogAnimation</item>
    </style>

    <!-- Dialog window animations: gentle fade+scale so glass dialogs
         condense into view / dissolve away instead of hard popping. -->
    <style name="GlassDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_glass_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_glass_out</item>
    </style>

    <style name="GlassCard">
        <item name="android:background">@drawable/bg_glass_card</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="GlassButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">0dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="FullScreenDialog" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/bg_surface</item>
    </style>

    <style name="SnapshotDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
